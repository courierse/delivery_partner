rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection
    match /orders/{orderId} {
      // Allow authenticated users to read orders with specific statuses
      allow read: if request.auth != null && resource.data.status in ['pending', 'accepted'];
      // Allow authenticated users to create orders with required fields
      allow create: if request.auth != null && 
        request.resource.data.keys().hasAll(['pickupLocation', 'dropLocation', 'pickupName', 'pickupPhone', 'dropName', 'dropPhone', 'weightRange', 'status', 'createdAt']) &&
        request.resource.data.status == 'pending';
      // Allow authenticated drivers to update orders only if they are accepting it
      allow update: if request.auth != null && 
        request.resource.data.status == 'accepted' && 
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.acceptedAt != null;
      // Restrict deletes
      allow delete: if false;
    }

    // Users collection (for user application)
    match /users/{phoneNumber} {
      allow read, write: if request.auth != null && request.auth.token.phone_number == phoneNumber;
    }

    // Drivers collection (for driver application)
    match /drivers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Driver notifications collection
    match /driver_notifications/{notificationId} {
      // Allow drivers to read their own notifications
      allow read: if request.auth != null && resource.data.driverId == request.auth.uid;
      // Allow creating notifications (for notification service/cloud functions)
      // Note: createdAt can be FieldValue.serverTimestamp() which is a sentinel value
      allow create: if request.auth != null && 
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.keys().hasAll(['driverId', 'orderId', 'title', 'body', 'pickupLocation', 'dropLocation', 'distance', 'vehicleType', 'isRead']) &&
        request.resource.data.isRead == false;
      // Allow drivers to update their own notifications (e.g., mark as read)
      allow update: if request.auth != null && 
        resource.data.driverId == request.auth.uid &&
        request.resource.data.driverId == request.auth.uid;
      // Prevent deletes
      allow delete: if false;
    }
  }
}